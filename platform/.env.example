# Copy to platform/.env (ignored by Git) and replace every "change-me" with a
# local-only value. Never put UAT or production values here.

NL_ENV=local

# Host MySQL 8.4 (outside Docker). Containers use host.docker.internal.
NL_DB_HOST=127.0.0.1
NL_DB_PORT=3306
NL_DB_NAME=nova_logistics
NL_DB_TLS=false
NL_DB_USER=nl_app
NL_DB_PASSWORD=change-me
NL_MIGRATE_DB_USER=nl_migrate
NL_MIGRATE_DB_PASSWORD=change-me

# MinIO (S3) in Docker.
NL_MINIO_ROOT_USER=nl-minio-root
NL_MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
NL_MINIO_API_PORT=9000
NL_MINIO_CONSOLE_PORT=9001
NL_S3_ENDPOINT=http://127.0.0.1:9000
NL_S3_REGION=us-east-1
NL_S3_BUCKET=nova-logistics-dev
NL_TEST_S3_BUCKET=nova-logistics-test
NL_S3_PATH_STYLE=true
NL_S3_ACCESS_KEY_ID=nl-app-local
NL_S3_SECRET_ACCESS_KEY=change-me-at-least-8-chars
NL_S3_MAX_GRANT_TTL=5m

# Redis in Docker (cache only).
NL_REDIS_PORT=6379
NL_REDIS_ADDR=127.0.0.1:6379
NL_REDIS_PASSWORD=change-me
NL_REDIS_DB=0
NL_REDIS_TLS=false

# Local development key for field encryption (32 bytes, base64). Cloud uses KMS.
NL_FIELD_KEY=change-me
